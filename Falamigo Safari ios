        // ============================================
        // LOGIN / CADASTRO
        // ============================================
        function fazerLogin() {
            var email = document.getElementById('loginEmail').value;
            var senha = document.getElementById('loginSenha').value;

            if (!email || !senha) {
                mostrarSnackbar('Preencha e-mail e senha', 'error');
                return;
            }

            var btn = document.getElementById('btnLogin');
            var btnText = document.getElementById('btnLoginText');
            btn.disabled = true;
            btnText.textContent = 'ENTRANDO...';

            // Simula delay de API
            setTimeout(function() {
                ESTADO.motorista = { id: '12345', nome: 'Carlos Silva', email: email };
                ESTADO.token = 'token_mock_' + Date.now();
                
                btn.disabled = false;
                btnText.textContent = 'ENTRAR';
                
                mostrarTela('telaApp');
                document.getElementById('bottomNav').style.display = 'flex';
                renderizarOfertas();
                mostrarSnackbar('Bem-vindo, Carlos!', 'success');
            }, 800);
        }

        function mostrarCadastro() {
            mostrarTela('telaCadastro');
        }

        function voltarLogin() {
            mostrarTela('telaLogin');
        }

        function fazerCadastro() {
            var nome = document.getElementById('cadNome').value;
            var email = document.getElementById('cadEmail').value;
            
            if (!nome || !email) {
                mostrarSnackbar('Preencha nome e e-mail', 'error');
                return;
            }

            mostrarSnackbar('Cadastro realizado! Aguarde aprovação.', 'success');
            setTimeout(function() {
                voltarLogin();
            }, 1500);
        }

        // ============================================
        // NAVEGAÇÃO APP
        // ============================================
        function mudarAba(aba) {
            ESTADO.abaAtiva = aba;
            
            // Atualiza tabs
