        function abrirScanner() {
            document.getElementById('scannerOverlay').classList.add('active');
            // Simula bip ao tocar na tela
            var overlay = document.getElementById('scannerOverlay');
            overlay.onclick = function(e) {
                if (e.target === overlay || e.target.classList.contains('scanner-frame')) {
                    fecharScanner();
                    ESTADO.pacotesBipados[ESTADO.paradaAtual] = true;
                    mostrarSnackbar('Pacote PKG-' + Date.now() + ' validado!', 'success');
                    renderizarRotaAtiva();
