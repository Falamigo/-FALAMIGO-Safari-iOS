                t.classList.toggle('active', i === aba);
            });
            document.querySelectorAll('.nav-item').forEach(function(t, i) {
                t.classList.toggle('active', i === aba);
            });

            if (aba === 0) renderizarOfertas();
            else renderizarMinhasEntregas();
