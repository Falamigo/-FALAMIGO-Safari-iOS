        const MINHAS_ENTREGAS_MOCK = [
            { id: 'ENT-001', regiao_nome: 'Zona Norte - Santana', status: 'EM_COLETA', progresso: 0 },
            { id: 'ENT-002', regiao_nome: 'Centro - Sé', status: 'CONCLUIDA', progresso: 100 },
