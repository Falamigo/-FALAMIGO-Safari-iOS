            var html = '';
            OFERTAS_MOCK.forEach(function(rota) {
                html += '<div class="card">' +
                    '<div class="oferta-header">' +
                        '<div>' +
                            '<div class="oferta-regiao">' + rota.regiao_nome + '</div>' +
                            '<div class="oferta-info">' + rota.total_pacotes + ' pacotes · ' + rota.distancia_km + ' km</div>' +
                        '</div>' +
                        '<div class="oferta-valor">R$ ' + rota.valor_frete.toFixed(2) + '</div>' +
                    '</div>' +
                    '<div class="tags-row">' +
                        '<div class="tag">⏱️ ' + (rota.tempo_estimado_min / 60).toFixed(1) + 'h estimadas</div>' +
                        '<div class="tag">📍 ' + rota.hub_nome + '</div>' +
                    '</div>' +
                    '<button class="btn-primary" onclick="aceitarRota(\'' + rota.id + '\', ' + rota.valor_frete + ')">' +
                        '✓ ACEITAR E INICIAR ROTA' +
