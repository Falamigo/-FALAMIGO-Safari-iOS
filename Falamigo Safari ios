                html += '<div class="card" style="' + (podeClicar ? 'cursor: pointer;' : '') + '" ' +
                    (podeClicar ? 'onclick="continuarEntrega(\'' + ent.id + '\')"' : '') + '>' +
                    '<div style="display: flex; align-items: center; gap: 12px;">' +
                        '<div style="width: 48px; height: 48px; border-radius: 50%; background: ' + cor + '20; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;">' +
                            icone +
                        '</div>' +
                        '<div style="flex: 1;">' +
                            '<div style="font-weight: 600;">' + ent.regiao_nome + '</div>' +
                            '<div style="font-size: 13px; color: #64748B;">' + texto + '</div>' +
                        '</div>' +
