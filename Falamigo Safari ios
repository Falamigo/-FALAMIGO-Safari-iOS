        function proximaParada() {
            if (ESTADO.paradaAtual < PARADAS_MOCK.length - 1) {
                ESTADO.paradaAtual++;
                ESTADO.pacotesBipados[ESTADO.paradaAtual] = false;
                renderizarRotaAtiva();
