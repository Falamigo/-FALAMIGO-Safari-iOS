            document.getElementById('rotaProgressoTexto').textContent = (ESTADO.paradaAtual + 1) + '/' + PARADAS_MOCK.length;
            document.getElementById('rotaProgressoBar').style.width = progresso + '%';

            var parada = PARADAS_MOCK[ESTADO.paradaAtual];
            var jaBipado = ESTADO.pacotesBipados[ESTADO.paradaAtual] || false;

            var html = '<div class="parada-card">' +
                '<div class="parada-header">' +
                    '<div class="parada-numero">' + (ESTADO.paradaAtual + 1) + '</div>' +
                    '<div>' +
                        '<div class="parada-nome">' + parada.destinatario_nome + '</div>' +
                        '<div style="color: #64748B; font-size: 13px;">' + parada.telefone + '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="parada-endereco">' + parada.endereco_completo + '</div>';

            if (parada.instrucoes) {
                html += '<div class="instrucao-box">ℹ️ ' + parada.instrucoes + '</div>';
            }

            html += '<div class="acoes-list">';

            if (!jaBipado) {
                html += '<button class="acao-item" onclick="abrirScanner()" style="border-color: #FDE68A; background: #FFFBEB;">' +
                    '<div class="acao-icon" style="background: #FEF3C7;">📷</div>' +
                    '<div class="acao-info">' +
                        '<div class="acao-titulo">Bipar Pacote</div>' +
                        '<div class="acao-sub">Escaneie a etiqueta</div>' +
                    '</div>' +
                '</button>';
            } else {
                html += '<div class="acao-item" style="border-color: #A7F3D0; background: #ECFDF5; opacity: 0.8;">' +
                    '<div class="acao-icon" style="background: #D1FAE5;">✓</div>' +
                    '<div class="acao-info">' +
                        '<div class="acao-titulo" style="color: #10B981;">Pacote Validado</div>' +
                        '<div class="acao-sub">Código confirmado</div>' +
                    '</div>' +
