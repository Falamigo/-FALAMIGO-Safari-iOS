        function aceitarRota(rotaId, valor) {
            mostrarSnackbar('Rota aceita! Frete: R$ ' + valor.toFixed(2), 'success');
            ESTADO.rotaAtual = rotaId;
            ESTADO.paradaAtual = 0;
            ESTADO.pacotesBipados = {};
            
            setTimeout(function() {
                mostrarTela('telaRota');
                document.getElementById('bottomNav').style.display = 'none';
                renderizarRotaAtiva();
            }, 800);
        }

        // ============================================
        // MINHAS ENTREGAS
        // ============================================
        function renderizarMinhasEntregas() {
            var container = document.getElementById('conteudoApp');
            
            if (MINHAS_ENTREGAS_MOCK.length === 0) {
                container.innerHTML = '<div class="empty-state"><div class="empty-icon">📦</div><p>Você ainda não aceitou nenhuma entrega</p></div>';
                return;
            }

            var html = '';
            MINHAS_ENTREGAS_MOCK.forEach(function(ent) {
                var cor = ent.status === 'EM_COLETA' ? '#F59E0B' : 
                         ent.status === 'EM_ROTA' ? '#3B82F6' : '#10B981';
                var icone = ent.status === 'EM_COLETA' ? '🏭' : 
                           ent.status === 'EM_ROTA' ? '🚚' : '✓';
                var texto = ent.status === 'EM_COLETA' ? 'Em coleta no hub' :
                           ent.status === 'EM_ROTA' ? 'Em entrega' : 'Finalizada';
