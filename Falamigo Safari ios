            var container = document.getElementById('conteudoApp');
            
            if (OFERTAS_MOCK.length === 0) {
                container.innerHTML = '<div class="empty-state"><div class="empty-icon">📡</div><p>Nenhuma oferta disponível</p><p style="font-size: 14px; margin-top: 8px;">Fique ligado! Novas rotas aparecem a todo momento.</p></div>';
                return;
