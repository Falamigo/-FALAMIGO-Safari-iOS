            { id: 'ROTA-002', regiao_nome: 'Zona Sul - Moema', valor_frete: 87.00, total_pacotes: 12, distancia_km: 9.8, tempo_estimado_min: 150, hub_nome: 'Hub Centro' },
            { id: 'ROTA-003', regiao_nome: 'Centro - República', valor_frete: 72.50, total_pacotes: 10, distancia_km: 7.2, tempo_estimado_min: 120, hub_nome: 'Hub Centro' },
